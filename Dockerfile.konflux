ARG CPU_BASE_IMAGE

FROM ${CPU_BASE_IMAGE} AS builder

USER root

COPY .konflux/requirements.txt ./requirements.txt

# Install strictly from the hashed lockfile so the hermetic (prefetched) build never resolves anything.
# It includes the mariadb, mmd and postgres extras; psycopg-c replaces psycopg[binary] (no such wheel
# on the AIPCC index) and links against libpq.so.5 from the base image.
RUN pip install --no-cache-dir --no-deps --require-hashes -r requirements.txt && \
    python -c "import psycopg; assert psycopg.pq.__impl__ == 'c', psycopg.pq.__impl__"

# uv is build tooling inherited from the base image, not a runtime dependency.
# Remove its bundled crypto and the uvx companion (RHOAIENG-97373).
RUN /opt/app-root/bin/python -m pip uninstall -y uv && \
    test ! -e /opt/app-root/bin/uv && \
    test ! -e /opt/app-root/bin/uvx

FROM ${CPU_BASE_IMAGE}

USER root

COPY --from=builder /opt/app-root/lib/python3.12/site-packages /opt/app-root/lib/python3.12/site-packages
COPY --from=builder /opt/app-root/bin /opt/app-root/bin

WORKDIR /opt/app-root

COPY src src
COPY pyproject.toml README.md ./

ARG VERSION="0.0.0.dev0"
ENV SETUPTOOLS_SCM_PRETEND_VERSION="${VERSION}"

RUN pip install --no-cache-dir --no-deps .

# uv is build tooling inherited from the base image, not a runtime dependency.
# Remove its bundled crypto and the uvx companion (RHOAIENG-97373).
RUN /opt/app-root/bin/python -m pip uninstall -y uv && \
    test ! -e /opt/app-root/bin/uv && \
    test ! -e /opt/app-root/bin/uvx

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=random

USER 1001
EXPOSE 8080 4443

CMD ["python", "-m", "trustyai_service.main"]

LABEL name="rhoai/odh-trustyai-service-py-rhel9" \
      com.redhat.component="odh-trustyai-service-py-rhel9" \
      io.k8s.display-name="odh-trustyai-service-py-rhel9" \
      io.k8s.description="Python implementation of TrustyAI Service for AI explainability and fairness" \
      description="Python implementation of TrustyAI Service for AI explainability and fairness" \
      summary="TrustyAI Service for AI explainability, fairness, and model evaluation" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
